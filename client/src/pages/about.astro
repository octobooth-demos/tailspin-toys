---
import Layout from '../layouts/Layout.astro';
import { getLocale, messages } from '../i18n';

const locale = getLocale(Astro.cookies.get('site-language')?.value);
const text = messages[locale];
---

<Layout title={text.aboutTitle} {locale}>
  <section class="max-w-5xl mx-auto px-4 py-8" data-testid="about-section">
    <div class="bg-slate-800/70 backdrop-blur-sm border border-slate-700 rounded-xl shadow-lg p-8 transition-colors duration-300">
      <h2 class="text-blue-400 text-4xl mb-8 pb-3 border-b border-slate-600 font-bold" data-testid="about-heading">{text.aboutHeading}</h2>
      
      <div class="space-y-6">
        <p class="text-lg leading-relaxed text-slate-300">
          {text.aboutParagraphOne}
        </p>
        
        <p class="text-lg leading-relaxed text-slate-300">
          {text.aboutParagraphTwo}
        </p>

        <p class="text-lg leading-relaxed text-slate-300">
          {text.aboutParagraphThree}
        </p>
      </div>
      
      <div class="mt-12 flex justify-center">
        <a href="/" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all duration-300 hover:shadow-lg hover:shadow-blue-600/20 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          {text.backToGames}
        </a>
      </div>
    </div>
  </section>
</Layout>