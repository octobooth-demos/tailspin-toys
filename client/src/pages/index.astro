---
import Layout from '../layouts/Layout.astro';
import GameList from '../components/GameList.svelte';
import { getLocale, messages } from '../i18n';

const locale = getLocale(Astro.cookies.get('site-language')?.value);
const text = messages[locale];
---

<Layout title={text.homeTitle} {locale}>
  <div class="py-8">
    <div class="max-w-3xl mb-10">
      <h1 class="text-4xl font-bold mb-4 text-slate-100">{text.welcomeHeading}</h1>
      <p class="text-xl text-slate-300">{text.welcomeDescription}</p>
    </div>
    
    <GameList client:load {locale} />
  </div>
</Layout>
