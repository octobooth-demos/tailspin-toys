---
import type { Locale } from "../i18n";
import { messages } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = messages[locale];
---

<header class="bg-blue-500 dark:bg-blue-700 text-white p-4 shadow-md transition-colors duration-300">
  <div class="container mx-auto flex justify-between items-center gap-4 pl-4 pr-4">
    <div class="flex items-center">
      <div class="relative group">
        <button id="menu-toggle" class="focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-500 rounded mr-4" aria-label={text.toggleMenu} aria-expanded="false" aria-controls="menu" data-testid="menu-toggle">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <nav id="menu" class="hidden absolute left-0 mt-2 w-48 bg-white dark:bg-slate-800 text-slate-800 dark:text-white rounded shadow-lg z-10 transition-colors duration-300">
          <ul class="py-1" role="menu">
            <li><a href="/" role="menuitem" class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-700">{text.home}</a></li>
            <li><a href="/about" role="menuitem" class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-700">{text.about}</a></li>
          </ul>
        </nav>
      </div>
      <div class="text-xl font-bold"><a href="/" class="hover:underline">Tailspin Toys</a></div>
    </div>
    <label class="flex items-center gap-2 text-sm font-medium" for="language-selector">
      <span class="sr-only">{text.languageLabel}</span>
      <select
        id="language-selector"
        aria-label={text.languageLabel}
        class="rounded-md border border-blue-300 bg-blue-700 px-2 py-1 text-white focus:outline-none focus:ring-2 focus:ring-white"
        data-testid="language-selector"
      >
        <option value="en" selected={locale === "en"}>English</option>
        <option value="fr" selected={locale === "fr"}>Français</option>
        <option value="es" selected={locale === "es"}>Español</option>
      </select>
    </label>
  </div>
</header>

<script>
  // Toggle menu visibility when hamburger is clicked
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');
  
  if (menuToggle && menu) {
    menuToggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      const isExpanded = !menu.classList.contains('hidden');
      menuToggle.setAttribute('aria-expanded', String(isExpanded));
      if (isExpanded) {
        const firstLink = menu.querySelector('a');
        if (firstLink) firstLink.focus();
      }
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      const target = event.target;
      const isClickInside = target instanceof Node && (menuToggle.contains(target) || menu.contains(target));
      if (!isClickInside && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Close menu with Escape key and return focus to toggle button
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.focus();
      }
    });
  }

  const languageSelector = document.querySelector<HTMLSelectElement>('[data-testid="language-selector"]');
  languageSelector?.addEventListener('change', () => {
    if (!['en', 'fr', 'es'].includes(languageSelector.value)) return;

    document.cookie = `site-language=${languageSelector.value}; path=/; max-age=31536000; samesite=lax`;
    window.location.reload();
  });
</script>